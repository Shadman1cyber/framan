# Template only; generate secrets locally. Never commit actual credentials.
DATABASE_URL=postgresql://farman:farman@localhost:5432/farman?schema=public
# Redis cache (optional). Empty/omitted → in-process memory cache fallback.
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true
NEXTAUTH_URL=http://localhost:3080
NEXTAUTH_SECRET=
PORT=3080
PUBLIC_APP_URL=
AI_ENABLED=false
AI_PROVIDER=zhipu
AI_MODEL=glm-4
ZHIPU_API_KEY=

# ── Agent workspace (R11) ──────────────────────────────────────────────
AGENT_ENABLED=false
AGENT_WRITES_ENABLED=false
# Gradual release (Phase 7). Shadow mode runs the full loop but blocks writes.
AGENT_SHADOW_MODE=false
# Comma-separated user IDs allowed to use the agent; empty = all authorized.
AGENT_CANARY_USERS=
# Unified workspace UI feature flag (R01). Legacy /admin/ai remains when off.
AGENT_WORKSPACE=false
# Existing sole Cafe ID, configured by deployment administrator. No shared tenancy.
AGENT_CAFE_ID=
# Graph staleness gate: graph results older than this are flagged stale and
# consumers must read sensitive answers from the live source.
GRAPH_MAX_STALE_SECONDS=300

# ── OpenObserve (R10) ──────────────────────────────────────────────────
# In Compose the app/worker reach the internal hostname over HTTP.
# Local (non-Compose) use: http://localhost:5080/api/default/v1/traces
# or https://observe.example/api/<org>/v1/traces for a hosted instance.
OPENOBSERVE_TRACES_URL=
# Basic <base64 user:password>, server-side only. Never printed in logs.
OPENOBSERVE_AUTHORIZATION=
# Narrow insecure-transport allowance: the explicit internal Compose hostname.
OPENOBSERVE_INTERNAL_HOST=openobserve
# Owner-facing dashboard link (rendered in the workspace diagnostics area).
OPENOBSERVE_DASHBOARD_URL=http://localhost:5080
# OpenObserve root login used to bootstrap the service (server-side only).
ZO_ROOT_USER_EMAIL=
ZO_ROOT_USER_PASSWORD=