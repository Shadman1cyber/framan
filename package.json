{
  "name": "farmans-cafe-menu",
  "version": "1.0.0",
  "private": true,
  "description": "Cafe 13 — universal native desktop terminal for Windows (cashier / kiosk)",
  "author": "Cafe 13",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3080}",
    "desktop:dev": "electron electron/main.cjs --server=http://localhost:3080",
    "desktop:dist:win": "electron-builder --win nsis portable --x64 --ia32",
    "desktop:dist:win64": "electron-builder --win nsis portable --x64",
    "desktop:clean": "node -e \"require('fs').rmSync('dist-desktop',{recursive:true,force:true})\"",
    "worker:build": "esbuild worker/bootstrap.ts --bundle --platform=node --format=cjs --outfile=worker/dist.cjs --external:@prisma/client --external:@next/env --alias:@=./src",
    "worker": "npm run worker:build && node worker/dist.cjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate:sqlite-to-pg": "tsx scripts/migrate-sqlite-to-pg.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "db:migrate:pg": "tsx scripts/migrate-sqlite-to-pg.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/network": "^8.0.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "next": "14.2.18",
    "next-auth": "^4.24.10",
    "next-pwa": "^5.6.0",
    "qrcode": "^1.5.4",
    "ioredis": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
