generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles: CUSTOMER | CASHIER | OWNER  (legacy ADMIN/STAFF are migrated at runtime)
model User {
  id           String           @id @default(cuid())
  name         String?
  email        String?          @unique
  phone        String?          @unique
  passwordHash String?
  role         String           @default("CUSTOMER")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  allergies    UserAllergy[]
  preferences  UserPreference[]
  orders       Order[]
  ratings      Rating[]
  dietaryTags  UserDietaryTag[]
  staffProfile Staff?

  @@index([role])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  nameFa      String
  nameEn      String?
  icon        String?
  description String?
  image       String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

// Ingredient doubles as the raw-material inventory record.
model Ingredient {
  id            String               @id @default(cuid())
  nameFa        String
  nameEn        String?
  description   String?
  isAllergen    Boolean              @default(false)
  unit          String               @default("GRAM")
  stockQuantity Float                @default(0)
  minQuantity   Float?
  costPerUnit   Float?
  supplier      String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  products      ProductIngredient[]
  allergens     IngredientAllergen[]
}

model Allergen {
  id          String               @id @default(cuid())
  key         String               @unique
  nameFa      String
  nameEn      String
  description String?
  icon        String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  ingredients IngredientAllergen[]
  products    ProductAllergen[]
  users       UserAllergy[]
}

model IngredientAllergen {
  ingredientId String
  allergenId   String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  allergen     Allergen   @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([ingredientId, allergenId])
}

model DietaryTag {
  id        String              @id @default(cuid())
  key       String              @unique
  nameFa    String
  nameEn    String
  icon      String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  products  ProductDietaryTag[]
  users     UserDietaryTag[]
}

model UserDietaryTag {
  userId       String
  dietaryTagId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Cascade)

  @@id([userId, dietaryTagId])
}

// allergenStatus has exactly two values: CONTAINS | FREE
model Product {
  id             String              @id @default(cuid())
  slug           String              @unique
  nameFa         String
  nameEn         String?
  description    String
  price          Int
  image          String?
  categoryId     String
  isAvailable    Boolean             @default(true)
  isFeatured     Boolean             @default(false)
  order          Int                 @default(0)
  allergenStatus String              @default("FREE")
  prepBaseMin    Int                 @default(3)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ingredients    ProductIngredient[]
  allergens      ProductAllergen[]
  dietaryTags    ProductDietaryTag[]
  ratings        Rating[]
  orderItems     OrderItem[]
  images         ProductImage[]
  coffeeLines    ProductCoffeeLine[]
  goals          Goal[]

  @@index([categoryId])
  @@index([isFeatured])
  @@index([isAvailable])
  @@index([categoryId, isAvailable])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  isPrimary Boolean @default(false)
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductIngredient {
  productId    String
  ingredientId String
  quantity     Float      @default(0)
  unit         String     @default("GRAM")
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
}

// A row means the product CONTAINS the allergen (no third state).
model ProductAllergen {
  productId  String
  allergenId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([productId, allergenId])
}

model ProductDietaryTag {
  productId    String
  dietaryTagId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Cascade)

  @@id([productId, dietaryTagId])
}

// Configurable coffee lines (e.g. House Blend, Ethiopia, Colombia...)
model CoffeeLine {
  id         String              @id @default(cuid())
  nameFa     String
  nameEn     String?
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  products   ProductCoffeeLine[]
  orderItems OrderItem[]
}

// Per-product price for a coffee line (final price at purchase time).
model ProductCoffeeLine {
  id           String     @id @default(cuid())
  productId    String
  coffeeLineId String
  price        Int
  isActive     Boolean    @default(true)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  coffeeLine   CoffeeLine @relation(fields: [coffeeLineId], references: [id], onDelete: Cascade)

  @@unique([productId, coffeeLineId])
}

model UserAllergy {
  id         String   @id @default(cuid())
  userId     String
  allergenId String
  severity   String   @default("AVOID")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@unique([userId, allergenId])
}

model UserPreference {
  id     String @id @default(cuid())
  userId String
  key    String
  value  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Cafe {
  id        String   @id @default(cuid())
  nameFa    String
  nameEn    String?
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
}

model Branch {
  id        String      @id @default(cuid())
  cafeId    String
  nameFa    String
  nameEn    String?
  slug      String      @unique
  address   String?
  isActive  Boolean     @default(true)
  cafe      Cafe        @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  tables    CafeTable[]
  qrCodes   QRCode[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model CafeTable {
  id           String             @id @default(cuid())
  branchId     String
  number       String
  label        String?
  isActive     Boolean            @default(true)
  isOccupied   Boolean            @default(false)
  occupiedAt   DateTime?
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qrCodes      QRCode[]
  orders       Order[]
  reservations TableReservation[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([branchId, number])
}

model TableReservation {
  id            String    @id @default(cuid())
  tableId       String
  customerName  String
  customerPhone String?
  guests        Int       @default(1)
  reservedAt    DateTime
  durationMin   Int       @default(60)
  status        String    @default("RESERVED") // RESERVED | SEATED | CANCELLED | NO_SHOW
  createdBy     String?
  table         CafeTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tableId, reservedAt])
}

model QRCode {
  id        String     @id @default(cuid())
  code      String     @unique
  branchId  String
  tableId   String?
  label     String?
  isActive  Boolean    @default(true)
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table     CafeTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  orders    Order[]

  @@index([branchId, isActive])
}

// orderType: TABLE | TAKEAWAY
// status: PENDING | CONFIRMED | PREPARING | READY | COMPLETED | CANCELLED
// READY means "آماده سرو" for table orders and "آماده تحویل" for takeaway orders.
model Order {
  id            String            @id @default(cuid())
  userId        String?
  qrCodeId      String?
  tableId       String?
  orderType     String            @default("TAKEAWAY")
  status        String            @default("PENDING")
  total         Int
  customerName  String?
  customerPhone String?
  notes         String?
  estPrepMin    Int?
  estPrepMax    Int?
  prepFactors   String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  qrCode        QRCode?           @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  table         CafeTable?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  stageEvents   OrderStageEvent[]

  @@index([status])
  @@index([userId])
  @@index([orderType])
  @@index([createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id             String      @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  price          Int
  notes          String?
  coffeeLineId   String?
  coffeeLineName String?
  optionPrice    Int         @default(0)
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  coffeeLine     CoffeeLine? @relation(fields: [coffeeLineId], references: [id], onDelete: SetNull)
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

// Kitchen/foyer staff — number of active chefs feeds the preparation estimator.
model Staff {
  id         String            @id @default(cuid())
  userId     String?           @unique
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  role       String            @default("CHEF") // CHEF | WAITER | OTHER
  task       String?
  shiftStart String? // HH:mm scheduled work start (e.g. "09:00")
  shiftEnd   String? // HH:mm scheduled work end (e.g. "18:00")
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  attendance StaffAttendance[]
  leaves     StaffLeave[]
}

// Staff check-in / check-out log with auto late/overtime minutes.
model StaffAttendance {
  id          String    @id @default(cuid())
  staffId     String
  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date        String // YYYY-MM-DD (business day, Asia/Tehran)
  checkIn     DateTime?
  checkOut    DateTime?
  lateMin     Int       @default(0)
  overtimeMin Int       @default(0)
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([staffId, date])
  @@index([staffId, date])
}

// Leave system: ADVANCE (staff request, approvable) | INSTANT (registered by manager).
// status: PENDING | APPROVED | REJECTED
model StaffLeave {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type      String   @default("ADVANCE") // ADVANCE | INSTANT
  from      DateTime
  to        DateTime
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId, status])
  @@index([from, to])
}

// Manager goal (تعیین هدف): metric TOTAL_SALES | TOTAL_PROFIT | ITEM_COUNT.
model Goal {
  id          String   @id @default(cuid())
  title       String
  metric      String // TOTAL_SALES | TOTAL_PROFIT | ITEM_COUNT
  targetValue Int
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  from        DateTime
  to          DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, from, to])
}

// Per-order preparation stage timestamps for wait-time analysis.
// stage: CREATED | CONFIRMED | PREPARING | READY | COMPLETED | CANCELLED
model OrderStageEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage     String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([stage, createdAt])
}

// Simple key/value application settings (AI enabled flag etc.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Sales Flow Settings — configurable operating hours and time granularity for sales visualization
model SalesFlowSettings {
  id             String              @id @default(cuid())
  granularityMin Int                 @default(30) // 15, 30, 60, 120
  timezone       String              @default("Asia/Tehran")
  schedules      SalesFlowSchedule[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model SalesFlowSchedule {
  id              String            @id @default(cuid())
  settingsId      String
  settings        SalesFlowSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  dayOfWeek       Int // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime       String // HH:mm format (e.g., "09:00")
  endTime         String // HH:mm format (e.g., "23:00")
  isEnabled       Boolean           @default(true)
  crossesMidnight Boolean           @default(false) // Schedule crosses midnight (e.g., 22:00–02:00)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([settingsId, dayOfWeek])
}

// AI generated insight/alert, persisted for the dashboard.
model AIInsight {
  id        String   @id @default(cuid())
  kind      String   @default("GENERAL") // INVENTORY | FINANCE | OPERATION | GENERAL
  severity  String   @default("INFO") // INFO | WARNING | CRITICAL
  title     String
  body      String
  createdAt DateTime @default(now())
}

// AI assistant conversation (chat history).
// ownerId == null marks a legacy (pre-ownership) session: read-only archive,
// visible only to OWNER holders; it is never claimed by a user implicitly.
model AIChatSession {
  id        String          @id @default(cuid())
  userId    String?
  ownerId   String?
  archived  Boolean         @default(false)
  title     String          @default("گفتگوی جدید")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  AIChatMessage[]

  @@index([ownerId, archived, updatedAt])
}

model AIChatMessage {
  id        String        @id @default(cuid())
  sessionId String
  role      String // user | assistant
  content   String
  createdAt DateTime      @default(now())
  session   AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// Data import/migration job (CSV from external accounting systems).
model ImportJob {
  id        String   @id @default(cuid())
  kind      String // PRODUCTS | INGREDIENTS | ORDERS | EXPENSES
  filename  String
  status    String   @default("COMPLETED") // COMPLETED | FAILED | PARTIAL
  report    String // JSON report
  createdAt DateTime @default(now())
}

// Single-installation agent execution. Scope is server-bound, never model supplied.
// Derived graph data (Phase 3). Never a business source of truth; volatile
// numbers must always be read from the live source tables.
model GraphNode {
  id            String      @id
  scopeId       String
  kind          String
  refId         String
  label         String
  searchText    String
  properties    String      @default("{}")
  sourceId      String
  sourceVersion String
  observedAt    DateTime
  validFrom     DateTime
  validTo       DateTime?
  status        String      @default("active")
  confidence    Float       @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  outEdges      GraphEdge[] @relation("from")
  inEdges       GraphEdge[] @relation("to")

  @@unique([scopeId, kind, refId])
  @@index([scopeId, status, kind])
}

model GraphEdge {
  id            String    @id
  scopeId       String
  relation      String
  from          GraphNode @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  fromId        String
  to            GraphNode @relation("to", fields: [toId], references: [id], onDelete: Cascade)
  toId          String
  sourceId      String
  sourceVersion String
  observedAt    DateTime
  validFrom     DateTime
  validTo       DateTime?
  status        String    @default("active")
  confidence    Float     @default(1)

  @@unique([scopeId, relation, fromId, toId])
  @@index([scopeId, fromId, status])
}

// Sync watermark per entity kind. SQLite interim: watermark polling of source
// updatedAt replaces the transactional outbox/CDC planned for PostgreSQL/Neo4j.
model GraphSync {
  id        String   @id
  scopeId   String
  entity    String
  watermark DateTime
  syncedAt  DateTime @default(now())

  @@unique([scopeId, entity])
}

model AgentRun {
  id             String         @id
  scopeId        String
  userId         String
  key            String
  requestHash    String
  traceId        String
  state          String         @default("queued")
  tool           String
  input          String
  inputHash      String
  version        String?
  previous       String?
  approvedBy     String?
  approvedHash   String?
  expiresAt      DateTime?
  result         String?
  lastError      String?        @map("error")
  attemptCount   Int            @default(0)
  // Phase 6 subagents: children are bounded instances under a supervisor run.
  parentRunId    String?
  toolCallBudget Int            @default(12)
  // Workspace linkage: the conversation a run belongs to (no FK by design;
  // legacy chats can be deleted without cascading execution history).
  sessionId      String?
  // Durable-queue lease fields (worker claiming; SQLite advisory locking).
  leaseOwner     String?
  leaseUntil     DateTime?
  // Bounded plan: ordered AgentStep rows executed by runtime/worker.
  planKind       String         @default("single") // single | plan
  // Task provenance persisted per run (R11).
  modelId        String?
  promptVersion  String?
  skillVersion   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  events         AgentEvent[]
  episodes       AgentEpisode[]
  steps          AgentStep[]

  @@unique([scopeId, userId, key])
  @@index([scopeId, userId, createdAt])
  @@index([sessionId])
  @@index([state, leaseUntil])
}

// One bounded step of a run's plan/execute/verify/respond loop. Steps are
// created and verified server-side; a write step always pauses the run at
// waiting_approval before its tool executes.
model AgentStep {
  id        String   @id
  runId     String
  scopeId   String
  idx       Int
  tool      String
  input     String
  state     String   @default("queued") // queued | running | succeeded | failed | cancelled | skipped
  result    String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, idx])
  @@index([scopeId, state])
}

// Private artifact storage metadata. Files live outside the public product
// image directory; delivery is authenticated and ownership-checked.
model AgentArtifact {
  id          String   @id
  scopeId     String
  runId       String?
  sessionId   String?
  kind        String // upload_csv | upload_xlsx | upload_txt | upload_pdf | report_csv | report_xlsx | chart_svg
  filename    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  checksum    String
  meta        String   @default("{}") // source refs + generation inputs
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([scopeId, createdAt])
  @@index([sessionId])
}

// Phase 4 memory. Episodes are derived facts from real run outcomes — never
// model-invented. Lessons are evidence-backed proposals; activation is an
// explicit human control action and never changes permissions or policy.
model AgentEpisode {
  id        String   @id
  scopeId   String
  runId     String
  userId    String
  tool      String
  state     String
  errorCode String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([scopeId, runId])
  @@index([scopeId, userId, createdAt])
}

model AgentLesson {
  id         String    @id
  scopeId    String
  topic      String
  statement  String
  status     String    @default("draft")
  evidence   String    @default("[]")
  proposedBy String
  reviewedBy String?
  validFrom  DateTime
  validTo    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([scopeId, status, topic])
}

// Phase 5 skills: versioned declarative workflows over allowlisted tools.
// Drafts come from real corrective episodes; activation and rollback are
// explicit human actions gated on a recorded sandbox evaluation. A skill can
// never grant permissions, change policy or activate itself.
model AgentSkill {
  id             String    @id
  scopeId        String
  slug           String
  version        String
  status         String    @default("draft")
  definition     String
  sourceEpisodes String    @default("[]")
  testResult     String?
  testedAt       DateTime?
  createdBy      String
  activatedBy    String?
  activatedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([scopeId, slug, version])
  @@index([scopeId, slug, status])
}

model AgentEvent {
  id               String    @id
  runId            String
  name             String
  state            String
  // Measured phase duration (tool/model/retrieval) when the event brackets work.
  durationMs       Int?
  // Provider-reported token usage when available; absent means unavailable.
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime  @default(now())
  exportedAt       DateTime?
  run              AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([exportedAt, createdAt])
}

model LedgerEntry {
  id              String    @id
  scopeId         String
  entryType       String    // ORDER_COMPLETED | ORDER_CANCELLED | EXPENSE | REVERSAL | CORRECTION
  referenceType   String    @default("order")
  referenceId     String?
  reversalOf      String?
  amount          Int       // signed toman (credit +, refund/void −)
  currency        String    @default("TOMAN")
  occurredAt      DateTime  // client timestamp (audit/display)
  accountId       String    @default("cash")
  deviceId        String
  idempotencyKey  String
  serverSequence  Int?
  serverReceivedAt DateTime?
  metadata        String    @default("{}")
  createdAt       DateTime  @default(now())
  @@index([scopeId, occurredAt])
  @@index([scopeId, accountId])
  @@index([referenceType, referenceId])
  @@unique([scopeId, idempotencyKey])
  @@unique([scopeId, reversalOf])
  @@unique([scopeId, serverSequence])
}

// Server-side outbox/idempotency record: (scope, idempotency_key) is unique so
// a retried or crashed-and-replayed push can never produce a second effect.
model SyncOperation {
  id             String    @id // operation_id (UUID)
  scopeId        String
  idempotencyKey String
  entityType     String    // ledger_entry
  entityId       String
  operationType  String    // CREATE_TRANSACTION | REVERSE_TRANSACTION | CORRECT_TRANSACTION
  payload        String    // JSON
  requestHash    String
  createdBy      String
  status         String    @default("applied") // applied | rejected
  result         String    @default("{}")
  serverSequence Int?
  deviceId       String?
  clientTimestamp DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@unique([scopeId, idempotencyKey])
  @@index([scopeId, serverSequence])
}

// Diagnostic record of devices that have pushed/pulled. Identity for
// authorization is always the session user; device_id is never trusted.
model SyncDevice {
  id          String   @id
  scopeId     String
  lastSeenAt  DateTime @default(now())
  userAgent   String?
  @@index([scopeId, lastSeenAt])
}

// Append-only inventory movement (migration 009). One row per stock change;
// Ingredient.stockQuantity is the mutable snapshot advanced additively inside
// the same transaction that inserts the row. Corrections are new rows.
// serverSequence shares the per-scope sequence space with LedgerEntry so a
// single pull cursor stays totally ordered across both change kinds.
model StockMovement {
  id               String    @id
  scopeId          String
  ingredientId     String
  delta            Float
  reason           String
  occurredAt       DateTime
  deviceId         String
  idempotencyKey   String
  serverSequence   Int?
  serverReceivedAt DateTime?
  createdAt        DateTime  @default(now())
  @@index([scopeId, occurredAt])
  @@index([scopeId, ingredientId])
  @@index([ingredientId])
  @@unique([scopeId, idempotencyKey])
  @@unique([scopeId, serverSequence])
}
